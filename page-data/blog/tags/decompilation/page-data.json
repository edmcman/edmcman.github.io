09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z"},"children":[]}]}]},{"type":"text","value":"The Research Team"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"This work was primarily conducted by "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Deniz Bölöni-Turgut"}]},{"type":"text","value":"—a bright\nundergraduate at Cornell University—as part of the REU in Software Engineering\n(REUSE) program at CMU. She was supervised by "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Luke Dramko"}]},{"type":"text","value":" from our research group."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"what-we-investigated","style":"position:relative;"},"children":[{"type":"element","tagName":"a","properties":{"href":"#what-we-investigated","ariaLabel":"what we investigated permalink","className":["anchor","before"]},"children":[{"type":"element","tagName":"svg","properties":{"ariaHidden":"true","focusable":"false","height":"16","version":"1.1","viewBox":"0 0 16 16","width":"16"},"children":[{"type":"element","tagName":"path","properties":{"fillRule":"evenodd","d":"M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z"},"children":[]}]}]},{"type":"text","value":"What We Investigated"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"This paper tackles an important question in the evolving landscape of AI-powered\nreverse engineering: "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"How do code obfuscations impact the effectiveness of\nthese ML-based approaches?"}]},{"type":"text","value":" In the real world, adversaries often employ\nobfuscation techniques to make their code harder to analyze by reverse\nengineers. Although these obfuscation techniques were not designed with machine\nlearning in mind, they can significantly modify the code, which raises the\nquestion of whether they could hinder the performance of ML models, which are\ncurrently trained on unobfuscated code."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"key-findings","style":"position:relative;"},"children":[{"type":"element","tagName":"a","properties":{"href":"#key-findings","ariaLabel":"key findings permalink","className":["anchor","before"]},"children":[{"type":"element","tagName":"svg","properties":{"ariaHidden":"true","focusable":"false","height":"16","version":"1.1","viewBox":"0 0 16 16","width":"16"},"children":[{"type":"element","tagName":"path","properties":{"fillRule":"evenodd","d":"M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z"},"children":[]}]}]},{"type":"text","value":"Key Findings"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Our research provides important quantitative insights into how obfuscations affect ML-based decompilation:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Obfuscations do negatively impact ML models"}]},{"type":"text","value":": We demonstrated that semantics-preserving transformations that obscure program functionality significantly reduce the accuracy of machine learning-based decompilation tools."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Training on obfuscated code helps"}]},{"type":"text","value":": Our experiments show that training models on obfuscated code can partially recover the lost accuracy, making the tools more resilient to obfuscation techniques."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Consistent results across multiple models"}]},{"type":"text","value":": We validated our findings across three different state-of-the-art models from the literature—DIRTY, HexT5, and VarBERT—suggesting that our findings generalize."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Practical implications for malware analysis"}]},{"type":"text","value":": Since obfuscations are commonly used in malware, these findings are directly applicable to improving real-world binary analysis scenarios."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"This work represents an important step forward in making ML-based decompilation\ntools more resilient against the obfuscation techniques commonly encountered in\nreal-world binary analysis scenarios. As the field continues to evolve,\nunderstanding these vulnerabilities and developing robust solutions will be\ncrucial for maintaining the effectiveness of AI-powered security tools."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"read-more","style":"position:relative;"},"children":[{"type":"element","tagName":"a","properties":{"href":"#read-more","ariaLabel":"read more permalink","className":["anchor","before"]},"children":[{"type":"element","tagName":"svg","properties":{"ariaHidden":"true","focusable":"false","height":"16","version":"1.1","viewBox":"0 0 16 16","width":"16"},"children":[{"type":"element","tagName":"path","properties":{"fillRule":"evenodd","d":"M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z"},"children":[]}]}]},{"type":"text","value":"Read More"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Want to know more?  "},{"type":"element","tagName":"a","properties":{"href":"https://edmcman.github.io/papers/dimva25.pdf"},"children":[{"type":"text","value":"Download the complete paper."}]}]}],"data":{"quirksMode":false}},"timeToRead":1,"fields":{"slug":"/blog/2025-07-11--quantifying-and-mitigating-the-impact-of-obfuscations-on-machine-learning-based-decompilation-improvement-published-at-dimva-2025/"},"frontmatter":{"tags":["papers","research","binary analysis","decompilation","ai","publications"],"title":"\"Quantifying and Mitigating the Impact