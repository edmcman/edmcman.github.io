{"componentChunkName":"component---src-templates-tags-page-tsx","path":"/blog/tags/talks/","result":{"data":{"tags":{"group":[{"fieldValue":"EVs","totalCount":1},{"fieldValue":"adventofcode","totalCount":2},{"fieldValue":"ansible","totalCount":1},{"fieldValue":"binary analysis","totalCount":1},{"fieldValue":"cars","totalCount":1},{"fieldValue":"dogs","totalCount":1},{"fieldValue":"fostering","totalCount":1},{"fieldValue":"fuzzing","totalCount":2},{"fieldValue":"ghidra","totalCount":1},{"fieldValue":"linux","totalCount":5},{"fieldValue":"notion","totalCount":1},{"fieldValue":"papers","totalCount":5},{"fieldValue":"pharos","totalCount":3},{"fieldValue":"programming","totalCount":4},{"fieldValue":"prolog","totalCount":1},{"fieldValue":"publications","totalCount":4},{"fieldValue":"quick thoughts","totalCount":2},{"fieldValue":"rescue","totalCount":1},{"fieldValue":"research","totalCount":6},{"fieldValue":"reverse engineering","totalCount":2},{"fieldValue":"rust","totalCount":2},{"fieldValue":"skiing","totalCount":2},{"fieldValue":"talks","totalCount":2},{"fieldValue":"travel","totalCount":1},{"fieldValue":"ubuntu","totalCount":2},{"fieldValue":"web","totalCount":3}]},"posts":{"totalCount":2,"edges":[{"node":{"htmlAst":{"type":"root","children":[{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"My family and I had quite the day attending the "},{"type":"element","tagName":"a","properties":{"href":"https://www.cposc.org"},"children":[{"type":"text","value":"2023 Central Pennsylvania Open\nSource Conference (CPOSC)"}]},{"type":"text","value":" yesterday at the Ware Center\nin Lancaster, PA.  In addition to attending, we spoke in three different talks!"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"My wife, Dr. Stephanie Schwartz, kicked things off.  "}]},{"type":"element","tagName":"figure","properties":{"className":["gatsby-resp-image-figure"],"style":""},"children":[{"type":"text","value":"\n    "},{"type":"element","tagName":"span","properties":{"className":["gatsby-resp-image-wrapper"],"style":"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 1800px; "},"children":[{"type":"text","value":"\n      "},{"type":"element","tagName":"span","properties":{"className":["gatsby-resp-image-background-image"],"style":"padding-bottom: 75.11111111111111%; position: relative; bottom: 0; left: 0; background-image: url('data:image/jpeg;base64,'); background-size: cover; display: block;"},"children":[]},{"type":"text","value":"\n  "},{"type":"element","tagName":"picture","properties":{},"children":[{"type":"text","value":"\n          "},{"type":"element","tagName":"source","properties":{"srcSet":["/static/5e403f4ebefe3b13be78183c9d16f8f1/e46ac/steph.avif 450w","/static/5e403f4ebefe3b13be78183c9d16f8f1/9b8d4/steph.avif 900w","/static/5e403f4ebefe3b13be78183c9d16f8f1/2eb22/steph.avif 1800w","/static/5e403f4ebefe3b13be78183c9d16f8f1/95b77/steph.avif 2048w"],"sizes":"(max-width: 1800px) 100vw, 1800px","type":"image/avif"},"children":[]},{"type":"element","tagName":"source","properties":{"srcSet":["/static/5e403f4ebefe3b13be78183c9d16f8f1/8626f/steph.webp 450w","/static/5e403f4ebefe3b13be78183c9d16f8f1/131f1/steph.webp 900w","/static/5e403f4ebefe3b13be78183c9d16f8f1/62ed8/steph.webp 1800w","/static/5e403f4ebefe3b13be78183c9d16f8f1/8df42/steph.webp 2048w"],"sizes":"(max-width: 1800px) 100vw, 1800px","type":"image/webp"},"children":[]},{"type":"text","value":"\n          "},{"type":"element","tagName":"source","properties":{"srcSet":["/static/5e403f4ebefe3b13be78183c9d16f8f1/20e5d/steph.jpg 450w","/static/5e403f4ebefe3b13be78183c9d16f8f1/8e1fc/steph.jpg 900w","/static/5e403f4ebefe3b13be78183c9d16f8f1/d9c39/steph.jpg 1800w","/static/5e403f4ebefe3b13be78183c9d16f8f1/e1596/steph.jpg 2048w"],"sizes":"(max-width: 1800px) 100vw, 1800px","type":"image/jpeg"},"children":[]},{"type":"text","value":"\n          "},{"type":"element","tagName":"img","properties":{"className":["gatsby-resp-image-image"],"src":"/static/5e403f4ebefe3b13be78183c9d16f8f1/d9c39/steph.jpg","alt":"Stephanie\npresenting","title":"","loading":"lazy","decoding":"async","style":"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;"},"children":[]},{"type":"text","value":"\n        "}]},{"type":"text","value":"\n    "}]},{"type":"text","value":"\n    "},{"type":"element","tagName":"figcaption","properties":{"className":["gatsby-resp-image-figcaption"]},"children":[{"type":"text","value":"Stephanie\npresenting"}]},{"type":"text","value":"\n  "}]},{"type":"text","value":"  She gave a short introduction on Random Forests as an\nintroduction for her student Samantha Noggle, in \"Machine Learning Techniques to\nImprove Users' Music Listening Experiences\".  I thought Samantha did a great job\non her presentation.  It was an interesting topic that she presented at just the\nright level of detail."},{"type":"element","tagName":"p","properties":{},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Next, my step son Nick Elzer, along with his coworker from\n"},{"type":"element","tagName":"a","properties":{"href":"https://www.quub.space"},"children":[{"type":"text","value":"Quub"}]},{"type":"text","value":", Nathaniel Every, gave his first ever public\nconference presentation, and did a great job!  "}]},{"type":"element","tagName":"figure","properties":{"className":["gatsby-resp-image-figure"],"style":""},"children":[{"type":"text","value":"\n    "},{"type":"element","tagName":"span","properties":{"className":["gatsby-resp-image-wrapper"],"style":"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 1800px; "},"children":[{"type":"text","value":"\n      "},{"type":"element","tagName":"span","properties":{"className":["gatsby-resp-image-background-image"],"style":"padding-bottom: 75.11111111111111%; position: relative; bottom: 0; left: 0; background-image: url('data:image/jpeg;base64,'); background-size: cover; display: block;"},"children":[]},{"type":"text","value":"\n  "},{"type":"element","tagName":"picture","properties":{},"children":[{"type":"text","value":"\n          "},{"type":"element","tagName":"source","properties":{"srcSet":["/static/dfdfd2ba33babbf1d62c4d7acd43c816/e46ac/nick.avif 450w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/9b8d4/nick.avif 900w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/2eb22/nick.avif 1800w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/95b77/nick.avif 2048w"],"sizes":"(max-width: 1800px) 100vw, 1800px","type":"image/avif"},"children":[]},{"type":"element","tagName":"source","properties":{"srcSet":["/static/dfdfd2ba33babbf1d62c4d7acd43c816/8626f/nick.webp 450w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/131f1/nick.webp 900w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/62ed8/nick.webp 1800w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/8df42/nick.webp 2048w"],"sizes":"(max-width: 1800px) 100vw, 1800px","type":"image/webp"},"children":[]},{"type":"text","value":"\n          "},{"type":"element","tagName":"source","properties":{"srcSet":["/static/dfdfd2ba33babbf1d62c4d7acd43c816/20e5d/nick.jpg 450w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/8e1fc/nick.jpg 900w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/d9c39/nick.jpg 1800w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/e1596/nick.jpg 2048w"],"sizes":"(max-width: 1800px) 100vw, 1800px","type":"image/jpeg"},"children":[]},{"type":"text","value":"\n          "},{"type":"element","tagName":"img","properties":{"className":["gatsby-resp-image-image"],"src":"/static/dfdfd2ba33babbf1d62c4d7acd43c816/d9c39/nick.jpg","alt":"Nick and Nathaniel\npresenting","title":"","loading":"lazy","decoding":"async","style":"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;"},"children":[]},{"type":"text","value":"\n        "}]},{"type":"text","value":"\n    "}]},{"type":"text","value":"\n    "},{"type":"element","tagName":"figcaption","properties":{"className":["gatsby-resp-image-figcaption"]},"children":[{"type":"text","value":"Nick and Nathaniel\npresenting"}]},{"type":"text","value":"\n  "}]},{"type":"text","value":"  Their presentation was \"SpaceHeX Beta1.0 Release - What\nIf, For Space Hardware Development, We Put Each Egg In Its Own Basket?\", and was\nabout SpaceHex, a prototyping system they open sourced to make it easier for\npeople to break into satellite development.  They also demoed a pretty sweet\nomnidirectional rover that they built (at 2am the night before, naturally)."},{"type":"element","tagName":"p","properties":{},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"blockquote","properties":{"className":["twitter-tweet"]},"children":[{"type":"element","tagName":"p","properties":{"lang":"en","dir":"ltr"},"children":[{"type":"text","value":"Started the open source repo for our space hardware development platform "},{"type":"element","tagName":"a","properties":{"href":"https://t.co/cRzHZkM6Gg"},"children":[{"type":"text","value":"https://t.co/cRzHZkM6Gg"}]},{"type":"element","tagName":"br","properties":{},"children":[]},{"type":"element","tagName":"br","properties":{},"children":[]},{"type":"text","value":"Had a blast presenting with "},{"type":"element","tagName":"a","properties":{"href":"https://twitter.com/Nick_elzer?ref_src=twsrc%5Etfw"},"children":[{"type":"text","value":"@Nick_elzer"}]},{"type":"text","value":" for "},{"type":"element","tagName":"a","properties":{"href":"https://twitter.com/quubspace?ref_src=twsrc%5Etfw"},"children":[{"type":"text","value":"@quubspace"}]},{"type":"text","value":"!"},{"type":"element","tagName":"br","properties":{},"children":[]},{"type":"element","tagName":"br","properties":{},"children":[]},{"type":"text","value":"Thank you "},{"type":"element","tagName":"a","properties":{"href":"https://twitter.com/CPOSC?ref_src=twsrc%5Etfw"},"children":[{"type":"text","value":"@CPOSC"}]},{"type":"text","value":" for having us! "},{"type":"element","tagName":"a","properties":{"href":"https://t.co/eRoHm5ea2u"},"children":[{"type":"text","value":"pic.twitter.com/eRoHm5ea2u"}]}]},{"type":"text","value":"— Nathaniel Evry (@NathanielEvry) "},{"type":"element","tagName":"a","properties":{"href":"https://twitter.com/NathanielEvry/status/1642204542921064452?ref_src=twsrc%5Etfw"},"children":[{"type":"text","value":"April 1, 2023"}]}]},{"type":"text","value":" "},{"type":"element","tagName":"script","properties":{"async":true,"src":"https://platform.twitter.com/widgets.js","charSet":"utf-8"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Finally, I gave a tutorial presentation called \"Introduction to Exploiting Stack\nBuffer Overflow Vulnerabilities\".  If you want, you can follow along\n"},{"type":"element","tagName":"a","properties":{"href":"https://github.com/edmcman/cposc-exploit"},"children":[{"type":"text","value":"here"}]},{"type":"text","value":" and the videos below. "}]},{"type":"element","tagName":"figure","properties":{"className":["gatsby-resp-image-figure"],"style":""},"children":[{"type":"text","value":"\n    "},{"type":"element","tagName":"span","properties":{"className":["gatsby-resp-image-wrapper"],"style":"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 1800px; "},"children":[{"type":"text","value":"\n      "},{"type":"element","tagName":"span","properties":{"className":["gatsby-resp-image-background-image"],"style":"padding-bottom: 75.11111111111111%; position: relative; bottom: 0; left: 0; background-image: url('data:image/jpeg;base64,'); background-size: cover; display: block;"},"children":[]},{"type":"text","value":"\n  "},{"type":"element","tagName":"picture","properties":{},"children":[{"type":"text","value":"\n          "},{"type":"element","tagName":"source","properties":{"srcSet":["/static/11b