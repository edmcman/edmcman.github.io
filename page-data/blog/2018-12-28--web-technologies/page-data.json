/ed.png 72w","sizes":"36px"},"sources":[{"srcSet":"/static/b0e73023d6a6055546d8e671edd67950/9a807/ed.webp 36w,\n/static/b0e73023d6a6055546d8e671edd67950/de323/ed.webp 72w","type":"image/webp","sizes":"36px"}]},"width":36,"height":36}}}}}}}]}},"pageContext":{"slug":"/blog/2018-12-28--web-technologies/"}},"staticQueryHashes":[],"slicesMap":{}}