ldren":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Next, my step son Nick Elzer, along with his coworker from\n"},{"type":"element","tagName":"a","properties":{"href":"https://www.quub.space"},"children":[{"type":"text","value":"Quub"}]},{"type":"text","value":", Nathaniel Every, gave his first ever public\nconference presentation, and did a great job!  "}]},{"type":"element","tagName":"figure","properties":{"className":["gatsby-resp-image-figure"],"style":""},"children":[{"type":"text","value":"\n    "},{"type":"element","tagName":"span","properties":{"className":["gatsby-resp-image-wrapper"],"style":"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 1800px; "},"children":[{"type":"text","value":"\n      "},{"type":"element","tagName":"span","properties":{"className":["gatsby-resp-image-background-image"],"style":"padding-bottom: 75.11111111111111%; position: relative; bottom: 0; left: 0; background-image: url('data:image/jpeg;base64,'); background-size: cover; display: block;"},"children":[]},{"type":"text","value":"\n  "},{"type":"element","tagName":"picture","properties":{},"children":[{"type":"text","value":"\n          "},{"type":"element","tagName":"source","properties":{"srcSet":["/static/dfdfd2ba33babbf1d62c4d7acd43c816/e46ac/nick.avif 450w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/9b8d4/nick.avif 900w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/2eb22/nick.avif 1800w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/95b77/nick.avif 2048w"],"sizes":"(max-width: 1800px) 100vw, 1800px","type":"image/avif"},"children":[]},{"type":"element","tagName":"source","properties":{"srcSet":["/static/dfdfd2ba33babbf1d62c4d7acd43c816/8626f/nick.webp 450w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/131f1/nick.webp 900w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/62ed8/nick.webp 1800w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/8df42/nick.webp 2048w"],"sizes":"(max-width: 1800px) 100vw, 1800px","type":"image/webp"},"children":[]},{"type":"text","value":"\n          "},{"type":"element","tagName":"source","properties":{"srcSet":["/static/dfdfd2ba33babbf1d62c4d7acd43c816/20e5d/nick.jpg 450w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/8e1fc/nick.jpg 900w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/d9c39/nick.jpg 1800w","/static/dfdfd2ba33babbf1d62c4d7acd43c816/e1596/nick.jpg 2048w"],"sizes":"(max-width: 1800px) 100vw, 1800px","type":"image/jpeg"},"children":[]},{"type":"text","value":"\n          "},{"type":"element","tagName":"img","properties":{"className":["gatsby-resp-image-image"],"src":"/static/dfdfd2ba33babbf1d62c4d7acd43c816/d9c39/nick.jpg","alt":"Nick and Nathaniel\npresenting","title":"","loading":"lazy","decoding":"async","style":"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;"},"children":[]},{"type":"text","value":"\n        "}]},{"type":"text","value":"\n    "}]},{"type":"text","value":"\n    "},{"type":"element","tagName":"figcaption","properties":{"className":["gatsby-resp-image-figcaption"]},"children":[{"type":"text","value":"Nick and Nathaniel\npresenting"}]},{"type":"text","value":"\n  "}]},{"type":"text","value":"  Their presentation was \"SpaceHeX Beta1.0 Release - What\nIf, For Space Hardware Development, We Put Each Egg In Its Own Basket?\", and was\nabout SpaceHex, a prototyping system they open sourced to make it easier for\npeople to break into satellite development.  They also demoed a pretty sweet\nomnidirectional rover that they built (at 2am the night before, naturally)."},{"type":"element","tagName":"p","properties":{},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"blockquote","properties":{"className":["twitter-tweet"]},"children":[{"type":"element","tagName":"p","properties":{"lang":"en","dir":"ltr"},"children":[{"type":"text","value":"Started the open source repo for our space hardware development platform "},{"type":"element","tagName":"a","properties":{"href":"https://t.co/cRzHZkM6Gg"},"children":[{"type":"text","value":"https://t.co/cRzHZkM6Gg"}]},{"type":"element","tagName":"br","properties":{},"children":[]},{"type":"element","tagName":"br","properties":{},"children":[]},{"type":"text","value":"Had a blast presenting with "},{"type":"element","tagName":"a","properties":{"href":"https://twitter.com/Nick_elzer?ref_src=twsrc%5Etfw"},"children":[{"type":"text","value":"@Nick_elzer"}]},{"type":"text","value":" for "},{"type":"element","tagName":"a","properties":{"href":"https://twitter.com/quubspace?ref_src=twsrc%5Etfw"},"children":[{"type":"text","value":"@quubspace"}]},{"type":"text","value":"!"},{"type":"element","tagName":"br","properties":{},"children":[]},{"type":"element","tagName":"br","properties":{},"children":[]},{"type":"text","value":"Thank you "},{"type":"element","tagName":"a","properties":{"href":"https://twitter.com/CPOSC?ref_src=twsrc%5Etfw"},"children":[{"type":"text","value":"@CPOSC"}]},{"type":"text","value":" for having us! "},{"type":"element","tagName":"a","properties":{"href":"https://t.co/eRoHm5ea2u"},"children":[{"type":"text","value":"pic.twitter.com/eRoHm5ea2u"}]}]},{"type":"text","value":"— Nathaniel Evry (@NathanielEvry) "},{"type":"element","tagName":"a","properties":{"href":"https://twitter.com/NathanielEvry/status/1642204542921064452?ref_src=twsrc%5Etfw"},"children":[{"type":"text","value":"April 1, 2023"}]}]},{"type":"text","value":" "},{"type":"element","tagName":"script","properties":{"async":true,"src":"https://platform.twitter.com/widgets.js","charSet":"utf-8"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Finally, I gave a tutorial presentation called \"Introduction to Exploiting Stack\nBuffer Overflow Vulnerabilities\".  If you want, you can follow along\n"},{"type":"element","tagName":"a","properties":{"href":"https://github.com/edmcman/cposc-exploit"},"children":[{"type":"text","val