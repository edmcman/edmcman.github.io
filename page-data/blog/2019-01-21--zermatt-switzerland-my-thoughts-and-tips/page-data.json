":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/b0e73023d6a6055546d8e671edd67950/8ef0e/ed.png","srcSet":"/static/b0e73023d6a6055546d8e671edd67950/8ef0e/ed.png 36w,\n/static/b0e73023d6a6055546d8e671edd67950/b0e74/ed.png 72w","sizes":"36px"},"sources":[{"srcSet":"/static/b0e73023d6a6055546d8e671edd67950/9a807/ed.webp 36w,\n/static/b0e73023d6a6055546d8e671edd67950/de323/ed.webp 72w","type":"image/webp","sizes":"36px"}]},"width":36,"height":36}}}}}}},{"node":{"id":"0e870298-6dca-5de9-bc4f-ba78659e67fa","fields":{"slug":"/blog/2023-11-25--click-for-full-screen/"},"timeToRead":1,"frontmatter":{"title":"Click for Full Screen","image":null,"author":{"jsonId":"Edward J. Schwartz","avatar":{"childImageSharp":{"gatsbyImageData":{"layout":"fixed","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/b0e73023d6a6055546d8e671edd67950/8ef0e/ed.png","srcSet":"/static/b0e73023d6a6055546d8e671edd67950/8ef0e/ed.png 36w,\n/static/b0e73023d6a6055546d8e671edd67950/b0e74/ed.png 72w","sizes":"36px"},"sources":[{"srcSet":"/static/b0e73023d6a6055546d8e671edd67950/9a807/ed.webp 36w,\n/static/b0e73023d6a6055546d8e671edd67950/de323/ed.webp 72w","type":"image/webp","sizes":"36px"}]},"width":36,"height":36}}}}}}},{"node":{"id":"78409ce4-0193-5f4a-8d1a-e2e623491a28","fields":{"slug":"/blog/2023-11-14--debugging-the-ghidra-decompiler/"},"timeToRead":16,"frontmatter":{"title":"Debugging the Ghidra Decompiler","image":null,"author":{"jsonId":"Edward J. Schwartz","avatar":{"childImageSharp":{"gatsbyImageData":{"layout":"fixed","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/b0e73023d6a6055546d8e671edd67950/8ef0e/ed.png","srcSet":"/static/b0e73023d6a6055546d8e671edd67950/8ef0e/ed.png 36w,\n/static/b0e73023d6a6055546d8e671edd67950/b0e74/ed.png 72w","sizes":"36px"},"sources":[{"srcSet":"/static/b0e73023d6a6055546d8e671edd67950/9a807/ed.webp 36w,\n/static/b0e73023d6a6055546d8e671edd67950/de323/ed.webp 72w","type":"image/webp","sizes":"36px"}]},"width":36,"height":36}}}}}}}]}},"pageContext":{"slug":"/blog/2019-01-21--zermatt-switzerland-my-thoughts-and-tips/"}},"staticQueryHashes":[],"slicesMap":{}}