:"/static/b0e73023d6a6055546d8e671edd67950/9a807/ed.webp 36w,\n/static/b0e73023d6a6055546d8e671edd67950/de323/ed.webp 72w","type":"image/webp","sizes":"36px"}]},"width":36,"height":36}}}}}}},{"node":{"id":"45368ee5-48ba-532a-a768-689d5a3b24b1","fields":{"slug":"/blog/2025-01-23--a-personal-manifesto/"},"timeToRead":2,"frontmatter":{"title":"A Personal Manifesto","image":null,"author":{"jsonId":"Edward J. Schwartz","avatar":{"childImageSharp":{"gatsbyImageData":{"layout":"fixed","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/b0e73023d6a6055546d8e671edd67950/8ef0e/ed.png","srcSet":"/static/b0e73023d6a6055546d8e671edd67950/8ef0e/ed.png 36w,\n/static/b0e73023d6a6055546d8e671edd67950/b0e74/ed.png 72w","sizes":"36px"},"sources":[{"srcSet":"/static/b0e73023d6a6055546d8e671edd67950/9a807/ed.webp 36w,\n/static/b0e73023d6a6055546d8e671edd67950/de323/ed.webp 72w","type":"image/webp","sizes":"36px"}]},"width":36,"height":36}}}}}}}]}},"pageContext":{"slug":"/blog/2020-04-06--research-vs-engineering/"}},"staticQueryHashes":[],"slicesMap":{}}