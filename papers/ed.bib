@InProceedings{brumley:2011:bap,
  author =       {David Brumley and Ivan Jager and Thanassis Avgerinos
                  and Edward J. Schwartz},
  title =        {BAP: A Binary Analysis Platform},
  booktitle =    cav,
  year =         2011,
  category =     papers,
  downloads =    {http://www.ece.cmu.edu/~ejschwar/papers/cav11.pdf
                  Paper;http://www.ece.cmu.edu/~ejschwar/pres/cav11.pdf
                  Slides;http://bap.ece.cmu.edu BAP website},
  abstract =     {BAP is a publicly available infrastructure for
                  performing program verification and analysis tasks
                  on binary (i.e., executable) code. In this paper, we
                  describe BAP as well as lessons learned from
                  previous incarnations of binary analysis
                  platforms. BAP explicitly represents all side
                  effects of instructions in an intermediate language
                  (IL), making syntax-directed analysis possible. We
                  have used BAP to routinely generate and solve
                  verification conditions that are hundreds of
                  megabytes in size and encompass 100,000s of assembly
                  instructions.}
}

@Article{brumley:2014:aeg,
  author =       {Thanassis Avgerinos and Sang Kil Cha and Alexandre
                  Rebert and Edward J. Schwartz and Maverick Woo and
                  David Brumley},
  title =        {Automatic Exploit Generation},
  journal =      cacm,
  year =         2014,
  volume =       57,
  category =     articles,
  abstract =     {Attackers commonly exploit buggy programs to break
                  into computers. Security-critical bugs pave the way
                  for attackers to install trojans, propagate worms,
                  and use victim computers to send spam and launch
                  denial-of-service attacks. A direct way, therefore,
                  to make computers more secure is to find
                  security-critical bugs before they are exploited by
                  attackers.  \par Unfortunately, bugs are
                  plentiful. For example, the Ubuntu Linux
                  bug-management database listed more than 103,000
                  open bugs as of January 2013. Specific widely used
                  programs (such as the Firefox Web browser and the
                  Linux 3.x kernel) list 7,597 and 1,293 open bugs in
                  their public bug trackers, respectively. Other
                  projects, including those that are closed-source,
                  likely involve similar statistics. These are just
                  the bugs we know; there is always the persistent
                  threat of zero-day exploits, or attacks against
                  previously unknown bugs.  \par Among the thousands
                  of known bugs, which should software developers fix
                  first? Which are exploitable?},
  downloads =
                  {http://cacm.acm.org/magazines/2014/2/171687-automatic-exploit-generation/abstract
                  CACM Link},
  number =       2,
  pages =        {74--84},
  month =        {February}
}

